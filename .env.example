DATABASE_NAME=payments_db
DATABASE_USERNAME=db_user
DATABASE_PASSWORD=db_password
DATABASE_PORT=5432
DATABASE_URL=postgresql+asyncpg://$DATABASE_USERNAME:$DATABASE_PASSWORD@postgres_payments:$DATABASE_PORT/$DATABASE_NAME
MIGRATION_DATABASE_URL=postgresql+psycopg://$DATABASE_USERNAME:$DATABASE_PASSWORD@postgres_payments:$DATABASE_PORT/$DATABASE_NAME

AUTH_API_KEY=api_key_for_auth

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@rabbitmq:5672/

LOG_LEVEL=INFO